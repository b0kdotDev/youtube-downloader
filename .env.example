RATE_LIMIT_PER_WINDOW=20
RATE_LIMIT_WINDOW_MS=60000
YTDL_TIMEOUT_MS=20000

# Required on Vercel: YouTube treats datacenter IPs as bots.
# Chrome → youtube.com (logged in) → DevTools → Network → any request → Request Headers → Cookie
YOUTUBE_COOKIE=
# Optional if cookie alone is not enough (BotGuard):
# YOUTUBE_PO_TOKEN=
# YOUTUBE_VISITOR_DATA=
