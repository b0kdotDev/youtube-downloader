RATE_LIMIT_PER_WINDOW=20
RATE_LIMIT_WINDOW_MS=60000
YTDL_TIMEOUT_MS=20000

# TV OAuth. Local: npm run youtube:login
# Paste the FULL printed JSON (access_token + refresh_token + expiry_date + client).
# A lone access token is not enough long-term; Vercel: paste JSON as one line, no extra quotes.
YOUTUBE_OAUTH=
# Optional fallback: Cookie header from a logged-in youtube.com tab
# YOUTUBE_COOKIE=
# YOUTUBE_PO_TOKEN=
# YOUTUBE_VISITOR_DATA=
